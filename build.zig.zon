.{
    .name = .slang,
    .version = "0.0.0",
    .minimum_zig_version = "0.15.2",
    .fingerprint = 0x681d367c56e59a99,
    // Third-party sources are git submodules upstream. A git submodule cannot
    // travel inside a Zig package tarball, so every one of them is also declared
    // here as a git dependency pinned to the same repository URL and commit as
    // the submodule. `zig fetch` treats the commit as the pin, so the two stay
    // in lockstep and the URL does not need rewriting when the submodule moves.
    // `lazy = true` keeps local development offline: a checkout that already has
    // the submodule populated never downloads these. See PORTING.md.
    .dependencies = .{
        .unordered_dense = .{
            .url = "git+https://github.com/martinus/unordered_dense#73f3cbb237e84d483afafc743f1f14ec53e12314",
